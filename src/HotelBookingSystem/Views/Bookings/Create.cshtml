@model BookingInputModel
@{
    ViewData["Title"] = "Book your room";
    var room = (Room)ViewBag.Room;
}
<section class="container section-space">
 <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id" class="back-link">← Back to room</a>
 <div class="row justify-content-center mt-3"><div class="col-12 col-lg-8">
  <div class="form-card">
   <span class="eyebrow text-accent">ALMOST THERE</span><h1 class="section-title">Book your stay</h1>
   <div class="booking-summary"><div><strong>@room.Name</strong><div class="text-secondary small">@room.RoomType · Up to @room.Capacity guests</div></div><strong>₹@room.PricePerNight.ToString("N0") <span class="text-secondary small">/ night</span></strong></div>
   <form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input asp-for="RoomId" type="hidden" />
    <div class="mb-3"><label asp-for="GuestName" class="form-label"></label><input asp-for="GuestName" class="form-control" placeholder="Enter your full name" /><span asp-validation-for="GuestName" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="GuestEmail" class="form-label"></label><input asp-for="GuestEmail" class="form-control" placeholder="you@example.com" /><span asp-validation-for="GuestEmail" class="text-danger small"></span></div>
    <div class="row g-3"><div class="col-12 col-md-6"><label asp-for="CheckIn" class="form-label"></label><input asp-for="CheckIn" class="form-control" /><span asp-validation-for="CheckIn" class="text-danger small"></span></div><div class="col-12 col-md-6"><label asp-for="CheckOut" class="form-label"></label><input asp-for="CheckOut" class="form-control" /><span asp-validation-for="CheckOut" class="text-danger small"></span></div></div>
    <div class="mt-3 mb-4"><label asp-for="Guests" class="form-label"></label><input asp-for="Guests" class="form-control" min="1" max="@room.Capacity" /><span asp-validation-for="Guests" class="text-danger small"></span></div>
    <button class="btn btn-primary btn-lg w-100">Confirm booking</button>
    <p class="small text-secondary mt-3 mb-0">No payment is collected in this demo.</p>
   </form>
  </div>
 </div></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
