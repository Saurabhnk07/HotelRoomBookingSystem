@model Room
@{
    ViewData["Title"] = Model.Name;
}
<section class="container section-space">
 <a asp-controller="Home" asp-action="Index" class="back-link">← Back to rooms</a>
 <div class="row g-5 mt-1 align-items-start">
  <div class="col-12 col-lg-7"><img class="details-image" src="@Model.ImageUrl" alt="@Model.Name" /></div>
  <div class="col-12 col-lg-5">
   <span class="room-type">@Model.RoomType</span><h1 class="display-6 fw-bold mt-3">@Model.Name</h1>
   <p class="text-secondary mt-3">@Model.Description</p>
   <div class="details-facts"><span>♙ Up to @Model.Capacity guests</span><span>✓ Free Wi-Fi</span><span>✓ Daily housekeeping</span></div>
   <div class="price-box mt-4"><span class="price fs-3">₹@Model.PricePerNight.ToString("N0")</span><span class="text-secondary"> / night</span></div>
   <a class="btn btn-primary btn-lg w-100 mt-4" asp-controller="Bookings" asp-action="Create" asp-route-roomId="@Model.Id">Book this room</a>
   <p class="small text-secondary mt-3">Your dates and availability are checked before a booking is confirmed.</p>
  </div>
 </div>
</section>
