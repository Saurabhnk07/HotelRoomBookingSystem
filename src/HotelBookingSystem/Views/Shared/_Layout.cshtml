<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - StayEase</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-lg navbar-dark site-nav">
  <div class="container">
    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">StayEase<span class="brand-dot">.</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="mainNav">
      <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
        <a class="nav-link" asp-controller="Home" asp-action="Index">Find a room</a>
        <a class="nav-link" asp-controller="Bookings" asp-action="Find">My bookings</a>
        <a class="nav-link" asp-controller="Admin" asp-action="Index">Staff</a>
        @if (User.Identity?.IsAuthenticated == true) {
          <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button class="btn btn-sm btn-outline-light ms-lg-2">Log out</button></form>
        } else {
          <a class="btn btn-sm btn-light ms-lg-2" asp-controller="Account" asp-action="Login">Staff login</a>
        }
      </div>
    </div>
  </div>
</nav>
</header>
<main>@RenderBody()</main>
<footer class="site-footer"><div class="container d-flex flex-column flex-md-row justify-content-between gap-2"><span>© @DateTime.Now.Year StayEase Hotel</span><span>Comfortable stays. Simple booking.</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
