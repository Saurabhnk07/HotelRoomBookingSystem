@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Staff dashboard";
}
<section class="container section-space"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><span class="eyebrow text-accent">STAFF WORKSPACE</span><h1 class="section-title">Bookings dashboard</h1><p class="text-secondary mb-0">Review reservations and update their status.</p></div><a class="btn btn-primary" asp-action="Rooms">Manage rooms</a></div>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="stat-card"><span>Total bookings</span><strong>@Model.Count()</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Confirmed</span><strong>@Model.Count(b => b.Status == BookingStatus.Confirmed)</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Pending</span><strong>@Model.Count(b => b.Status == BookingStatus.Pending)</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Cancelled</span><strong>@Model.Count(b => b.Status == BookingStatus.Cancelled)</strong></div></div></div>
<div class="table-responsive"><table class="table align-middle booking-table"><thead><tr><th>Guest</th><th>Room</th><th>Dates</th><th>Guests</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody>
@foreach(var b in Model){<tr><td><strong>@b.GuestName</strong><div class="small text-secondary">@b.GuestEmail</div></td><td>@b.Room?.Name</td><td>@b.CheckIn.ToString("dd MMM") – @b.CheckOut.ToString("dd MMM yyyy")</td><td>@b.Guests</td><td>₹@b.TotalPrice.ToString("N0")</td><td><span class="status-pill">@b.Status</span></td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@b.Id"/><select class="form-select form-select-sm" name="status">@foreach(BookingStatus s in Enum.GetValues<BookingStatus>()){<option value="@s" selected="@(s == b.Status)">@s</option>}</select><button class="btn btn-sm btn-outline-primary">Save</button></form></td></tr>}
</tbody></table></div></section>
